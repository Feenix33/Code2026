# =================================================================
# TEST SCRIPT 1: FUNCTIONALITY & ALIGNMENT MATRIX
# Checks: Fonts, Alignments, Color formats, Dashes, & Primitive Shapes
# =================================================================

# --- Header Banner ---
fillColor("#2C3E50")
rect(0, 732, 612, 60, 0, 1)

fillColor("#FFFFFF")
setFont("Helvetica-Bold", 18)
drawCentredString(306, 755, "Test Script 01: Functionality & Layout Matrix")

# --- Section 1: Text Alignment Anchors ---
setFont("Helvetica-Bold", 12)
fillColor("#333333")
drawString(50, 680, "1. Text Alignment Alignment Test (x = 306)")

# Target Reference Line
strokeColor("#E74C3C")
setLineWidth(1)
setDash(2, 2)
line(306, 580, 306, 670)
setDash()  # Reset dash

setFont("Helvetica", 11)
fillColor("#2C3E50")
drawString(306, 650, "drawString() [Left-aligned at 306]")
drawCentredString(306, 625, "drawCentredString() [Centered at 306]")
drawRightString(306, 600, "drawRightString() [Right-aligned at 306]")

# --- Section 2: Stroke Line Widths & Dash Configurations ---
setFont("Helvetica-Bold", 12)
fillColor("#333333")
drawString(50, 540, "2. Line Widths & Dash Pattern Test")

strokeColor("#2980B9")
setLineWidth(1)
line(50, 510, 550, 510)

setLineWidth(3)
strokeColor("#8E44AD")
setDash(8, 4)
line(50, 480, 550, 480)

setLineWidth(5)
strokeColor("#16A085")
setDash(15, 5)
line(50, 440, 550, 440)

setDash()  # Reset to solid

# --- Section 3: Rectangles & Circles (Fill vs Stroke Matrix) ---
setFont("Helvetica-Bold", 12)
fillColor("#333333")
drawString(50, 390, "3. Shapes Matrix (Stroke / Fill Variations)")

# Rectangles: Stroke Only, Fill Only, Both
strokeColor("#27AE60")
fillColor("#2ECC71")
setLineWidth(2)

rect(50, 300, 80, 60, 1, 0)   # Stroke only
rect(150, 300, 80, 60, 0, 1)  # Fill only
rect(250, 300, 80, 60, 1, 1)  # Stroke & Fill

# Circles: Stroke Only, Fill Only, Both
strokeColor("#D35400")
fillColor("#E67E22")

circle(400, 330, 30, 1, 0)    # Stroke only
circle(470, 330, 30, 0, 1)    # Fill only
circle(540, 330, 30, 1, 1)    # Stroke & Fill

# Subtitles for shapes
setFont("Helvetica", 9)
fillColor("#7F8C8D")
drawCentredString(90, 285, "Stroke Only")
drawCentredString(190, 285, "Fill Only")
drawCentredString(290, 285, "Stroke & Fill")

# Footer
strokeColor("#BDC3C7")
setLineWidth(0.5)
line(50, 50, 562, 50)
drawCentredString(306, 35, "Page 1 - End of Functionality Test")
